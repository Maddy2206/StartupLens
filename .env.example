# Copy to backend/.env and fill in values

# LLM — Alibaba Cloud DashScope (Qwen)
# Get key from: https://bailian.console.aliyun.com/ → API Key
DASHSCOPE_API_KEY=sk-...
# qwen-turbo / qwen-plus / qwen-max
LLM_MODEL=qwen-plus

# Research APIs (all optional)
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=startup-validator/1.0

# Database (docker-compose sets this automatically for the backend service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/startup_validator

# API
CORS_ORIGINS=http://localhost:3000
ENABLE_VECTOR_STORE=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
