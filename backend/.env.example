# LLM — Alibaba Cloud DashScope (Qwen)
# Get your API key from: https://bailian.console.aliyun.com/ → API Key
DASHSCOPE_API_KEY=sk-...

# Model options:
#   qwen-turbo  — fastest, cheapest
#   qwen-plus   — recommended default (good balance)
#   qwen-max    — highest quality, slower
LLM_MODEL=qwen-plus

# Research APIs (all optional — pipeline falls back to LLM reasoning if missing)
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=startup-validator/1.0

# Database (docker-compose sets this automatically for the backend service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/startup_validator

# API
CORS_ORIGINS=http://localhost:3000
ENABLE_VECTOR_STORE=false
